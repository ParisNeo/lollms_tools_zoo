# Bibliography Tools Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# =============================================================================
# ZOTERO CONFIGURATION (Required for remote Zotero access)
# =============================================================================
# Get your API key from: https://www.zotero.org/settings/keys
# Create a new private key with read/write permissions as needed

ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_USER_ID=your_zotero_user_id_here

# Library type: 'user' for personal library, 'group' for shared group library
ZOTERO_LIBRARY_TYPE=user

# Only required if ZOTERO_LIBRARY_TYPE=group
# Find your group ID in the group URL: https://www.zotero.org/groups/12345678/group_name
ZOTERO_GROUP_ID=

# =============================================================================
# CROSSREF CONFIGURATION (Optional - for higher rate limits)
# =============================================================================
# Crossref API is free for basic usage without an API key
# Register at: https://www.crossref.org/documentation/retrieve-metadata/rest-api/
# for higher rate limits and better service

CROSSREF_API_KEY=your_crossref_api_key_here

# Your email address - helps Crossref identify your application
# and provides better rate limits (polite pool)
CROSSREF_MAILTO=your_email@example.com

# =============================================================================
# SEMANTIC SCHOLAR CONFIGURATION (Optional)
# =============================================================================
# Semantic Scholar API is free but rate-limited
# Get an API key for higher limits: https://www.semanticscholar.org/product/api

SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# =============================================================================
# OPENALEX CONFIGURATION (Optional)
# =============================================================================
# OpenAlex is free and open, but you can provide an email for the polite pool
# Documentation: https://docs.openalex.org/

OPENALEX_MAILTO=your_email@example.com

# =============================================================================
# PUBMED CONFIGURATION (Optional)
# =============================================================================
# NCBI E-utilities API key for PubMed access
# Get one at: https://www.ncbi.nlm.nih.gov/account/settings/

PUBMED_API_KEY=your_pubmed_api_key_here
PUBMED_EMAIL=your_email@example.com

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Default download directory for papers and attachments
BIBLIOGRAPHY_DOWNLOAD_DIR=./downloads

# Default citation format (bibtex, apa, mla, chicago, harvard)
BIBLIOGRAPHY_DEFAULT_CITATION_FORMAT=bibtex

# Request timeout in seconds
BIBLIOGRAPHY_REQUEST_TIMEOUT=30

# Enable debug logging (true/false)
BIBLIOGRAPHY_DEBUG=false